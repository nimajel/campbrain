{
  "name": "campbrain",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.38",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "bun --filter @campbrain/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
