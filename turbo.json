{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "env": ["DATABASE_URL"] },
    "@campbrain/scanner#test": { "dependsOn": ["^build", "@campbrain/db#test", "@campbrain/api#test"], "env": ["DATABASE_URL"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {}
  }
}
