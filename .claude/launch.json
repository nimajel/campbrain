{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web && npx next dev --port 3002"],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "storybook"],
      "port": 6006,
      "autoPort": false
    }
  ]
}
